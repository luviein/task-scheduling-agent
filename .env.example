GEMINI_API_KEY=your-key-here
# Optional: override the default model
# GEMINI_MODEL=gemini-2.5-flash

# mock (default) or google. google needs credentials.json in the project root.
CALENDAR_BACKEND=mock

# Optional. Set from the provider's pricing page to see dollars alongside
# tokens. Left unset, spend is reported in tokens and seconds only, because a
# made-up rate in a report is worse than no rate.
# INPUT_COST_PER_MTOK=0.10
# OUTPUT_COST_PER_MTOK=0.40
